# --- App ---
NODE_ENV=development
PORT=5000
APP_NAME=e-wallet
VERSION=1

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=e_wallet_user
DB_PASSWORD=e_wallet_password
DB_NAME=e-wallet
DB_POOL_SIZE=10
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6378
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fintech:
REDIS_TLS=false

# --- Logging (winston + winston-daily-rotate-file) ---
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_ZIPPED_ARCHIVE=true

# PEPPER
NIN_PEPPER=
BVN_PEPPER=
PASSWORD_PEPPER=

# MAIL
MAIL_HOST=
MAIL_PORT=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USER=
MAIL_SECURE=true