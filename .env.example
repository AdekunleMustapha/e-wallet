# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=fintech-backend

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_NAME=fintech
DB_POOL_SIZE=10
DB_LOGGING=false

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fintech:
REDIS_TLS=false

# --- Logging (winston + winston-daily-rotate-file) ---
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_ZIPPED_ARCHIVE=true
